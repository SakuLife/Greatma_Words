# Application Settings
APP_NAME=GreatMan Words Generator
APP_ENV=development
DEBUG=true

# AI API Keys
# Claude推奨: 事実確認に強い
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OpenAI: 高速だが事実確認はClaude推奨
OPENAI_API_KEY=your_openai_api_key_here
# Gemini API (Google)
GEMINI_API_KEY=your_gemini_api_key_here

# Image Generation
USE_DALLE=true
SKIP_IMAGE_GENERATION=false
STABILITY_API_KEY=your_stability_api_key_here
REPLICATE_API_KEY=your_replicate_api_key_here

# KIEAI API (nanobanana)
USE_KIEAI=true
KIEAI_API_KEY=your_kieai_api_key_here
KIEAI_API_URL=https://api.kie.ai/api/v1
KIEAI_MODEL=google/nano-banana

# VOICEVOX Settings
VOICEVOX_API_URL=http://localhost:50021
VOICEVOX_SPEAKER_ID=13

# YouTube API Settings
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.upload
YOUTUBE_DEFAULT_CATEGORY=22
YOUTUBE_DEFAULT_PRIVACY=private

# Google Drive Settings
GOOGLE_CLIENT_SECRETS_FILE=client_secrets.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Google Sheets Settings
GOOGLE_SHEETS_ID=your_google_sheets_id_here

# Discord Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# File Paths
DATA_DIR=./data
PROJECTS_DIR=./data/projects
TEMPLATES_DIR=./data/templates

# Video Settings
VIDEO_RESOLUTION=1920x1080
VIDEO_FPS=30
VIDEO_BITRATE=5000k
DEFAULT_BACKGROUND_COLOR=#1a1a2e
DEFAULT_TEXT_COLOR=#ffffff

# Script Generation Settings
DEFAULT_SCRIPT_LENGTH=15
DEFAULT_LLM_MODEL=models/gemini-pro-latest
DEFAULT_TEMPERATURE=0.7

# Thumbnail Generation
USE_THUMBNAIL_GENERATION=true
SKIP_THUMBNAIL_GENERATION=false
THUMBNAIL_PROVIDER=nanobanana
NANOBANANA_API_KEY=your_nanobanana_api_key_here
NANOBANANA_API_URL=https://api.nanobanana.ai/v1
